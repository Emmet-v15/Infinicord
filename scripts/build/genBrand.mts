/*
 * Infinicord brand asset generator.
 *
 * Reads rebrand/palette.json (falls back to built-in defaults if absent so
 * fresh clones always build) and emits every derived brand artifact:
 *
 *   - src/renderer/styles/brand.generated.css  (css vars for the app bundle)
 *   - static/views/brand.generated.css         (same vars for splash/updater views)
 *   - static/views/brand-splash.svg            (purple pentagon splash logo)
 *   - build/icon.svg|png|ico + static/icon.ico|png  (app/installer icons)
 *
 * Run automatically by scripts/build/build.mts; can also be run directly:
 *   bun scripts/build/genBrand.mts
 *
 * Icon rasterization needs the optional dev dependency `sharp`; without it
 * the CSS/SVG artifacts are still written and previously generated icons
 * are left in place.
 */

import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

interface Palette {
    name: string;
    colors: Record<string, string>;
    gradients: Record<string, string>;
}

const FALLBACK: Palette = {
    name: "Infinicord",
    colors: {
        primary: "#7C3AED",
        primaryLight: "#A78BFA",
        primaryBright: "#8B5CF6",
        primaryDark: "#6D28D9",
        primaryDeep: "#4C1D95",
        onPrimary: "#FFFFFF"
    },
    gradients: {
        brandBar: "linear-gradient(90deg, #6D28D9 0%, #8B5CF6 100%)",
        logoFill: "linear-gradient(180deg, #A78BFA 0%, #7C3AED 55%, #6D28D9 100%)"
    }
};

const ROOT = process.cwd();

function loadPalette(): Palette {
    try {
        return { ...FALLBACK, ...JSON.parse(readFileSync(join(ROOT, "rebrand", "palette.json"), "utf-8")) };
    } catch {
        console.warn("[genBrand] rebrand/palette.json not found — using built-in defaults");
        return FALLBACK;
    }
}

const kebab = (s: string) => s.replace(/([a-z0-9])([A-Z])/g, "$1-$2").toLowerCase();

function cssVars(p: Palette): string {
    const colors = Object.entries(p.colors)
        .map(([k, v]) => `    --infinicord-${kebab(k)}: ${v};`)
        .join("\n");
    const gradients = Object.entries(p.gradients)
        .map(([k, v]) => `    --infinicord-gradient-${kebab(k)}: ${v};`)
        .join("\n");
    return `/* Generated by scripts/build/genBrand.mts from rebrand/palette.json — do not edit */\n:root {\n${colors}\n${gradients}\n}\n`;
}

function pentagonPts(center: number, radius: number) {
    return Array.from({ length: 5 }, (_, i) => {
        const a = (90 + i * 72) * (Math.PI / 180); // starts pointing DOWN
        return [center + radius * Math.cos(a), center + radius * Math.sin(a)];
    });
}

// star path: visit every second vertex (0 -> 2 -> 4 -> 1 -> 3 -> close)
const STAR_ORDER = [0, 2, 4, 1, 3];
const toPoints = (pts: number[][]) => pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");

function pentagonSvg(p: Palette): string {
    // DEMONIC PENTAGRAM: inverted silhouette + unicursal {5/2} star lines
    // ("vertices take the longest 2 paths"). Everything stays FLAT — no
    // baked shading, because the whole thing spins. Runtime lighting lives
    // in static/views/splash.html (drop-shadow glow + fixed radial vignette,
    // both rotation-safe).
    const pts = toPoints(pentagonPts(64, 56));
    const star = toPoints(STAR_ORDER.map(i => pentagonPts(64, 56)[i]));

    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="128" height="128">
  <polygon points="${pts}" fill="${p.colors.primaryDeep}" stroke="${p.colors.primary}" stroke-width="3"/>
  <polygon points="${star}" fill="none" stroke="${p.colors.primaryBright}" stroke-width="5"
           stroke-linejoin="miter" stroke-linecap="butt"/>
</svg>
`;
}

function iconSvg(p: Palette): string {
    // app/installer icon: pentagram centered on a rounded purple tile
    const all = pentagonPts(128, 74);
    const pts = toPoints(all);
    const star = toPoints(STAR_ORDER.map(i => all[i]));

    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="256" height="256">
  <defs>
    <linearGradient id="tile" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="${p.colors.primaryDark}"/>
      <stop offset="1" stop-color="${p.colors.primaryDeep}"/>
    </linearGradient>
    <linearGradient id="star" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="${p.colors.primaryLight}"/>
      <stop offset="1" stop-color="${p.colors.primaryBright}"/>
    </linearGradient>
  </defs>
  <rect width="256" height="256" rx="56" fill="url(#tile)"/>
  <polygon points="${pts}" fill="${p.colors.primaryDeep}" stroke="url(#star)" stroke-width="4"/>
  <polygon points="${star}" fill="none" stroke="url(#star)" stroke-width="7"
           stroke-linejoin="miter" stroke-linecap="butt"/>
</svg>
`;
}

/** Multi-size PNG-in-ICO container (Vista+; all sizes stored as embedded PNGs). */
function buildIco(pngs: Array<{ size: number; data: Buffer }>): Buffer {
    const header = Buffer.alloc(6);
    header.writeUInt16LE(1, 2); // type: icon
    header.writeUInt16LE(pngs.length, 4);
    const entries = Buffer.alloc(16 * pngs.length);
    let offset = 6 + 16 * pngs.length;
    const blobs: Buffer[] = [];
    pngs.forEach(({ size, data }, i) => {
        const e = entries.subarray(i * 16, i * 16 + 16);
        e.writeUInt8(size >= 256 ? 0 : size, 0);
        e.writeUInt8(size >= 256 ? 0 : size, 1);
        e.writeUInt16LE(1, 4); // planes
        e.writeUInt16LE(32, 6); // bpp
        e.writeUInt32LE(data.length, 8);
        e.writeUInt32LE(offset, 12);
        offset += data.length;
        blobs.push(data);
    });
    return Buffer.concat([header, entries, ...blobs]);
}

async function writeIcons(p: Palette): Promise<void> {
    let sharp: typeof import("sharp").default;
    try {
        sharp = (await import("sharp")).default;
    } catch {
        console.warn("[genBrand] sharp not installed — skipping icon rasterization (bun install to refresh icons)");
        return;
    }

    const svg = Buffer.from(iconSvg(p));
    const png512 = await sharp(svg).resize(512, 512).png().toBuffer();
    writeFileSync(join(ROOT, "build", "icon.png"), png512);
    writeFileSync(join(ROOT, "static", "icon.png"), png512);

    const sizes = [16, 24, 32, 48, 64, 128, 256];
    const pngs = await Promise.all(
        sizes.map(async size => ({ size, data: await sharp(svg).resize(size, size).png().toBuffer() }))
    );
    const ico = buildIco(pngs);
    writeFileSync(join(ROOT, "build", "icon.ico"), ico);
    writeFileSync(join(ROOT, "static", "icon.ico"), ico);

    // linux: installer + desktop entries want an svg icon
    writeFileSync(join(ROOT, "build", "icon.svg"), iconSvg(p));

    console.log("[genBrand] wrote brand icons (png, ico, svg)");
}

export async function generateBrand(): Promise<void> {
    const palette = loadPalette();

    const rendererOut = join(ROOT, "src", "renderer", "styles", "brand.generated.css");
    writeFileSync(rendererOut, cssVars(palette));

    const viewsOut = join(ROOT, "static", "views", "brand.generated.css");
    writeFileSync(viewsOut, cssVars(palette));

    const svgOut = join(ROOT, "static", "views", "brand-splash.svg");
    writeFileSync(svgOut, pentagonSvg(palette));

    await writeIcons(palette);

    console.log(`[genBrand] wrote brand artifacts (${palette.name})`);
}

if (process.argv[1] && import.meta.url.endsWith(process.argv[1].replace(/\\/g, "/").split("/").pop()!)) {
    await generateBrand();
}
